NODE_ENV=development
PORT=5000
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/CustomWebsiteBuilder?schema=public"

JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-at-least-32-characters

ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:3000
COOKIE_DOMAIN=

SIGNUP_RATE_LIMIT_WINDOW_MS=60000
SIGNUP_RATE_LIMIT_MAX_REQUESTS=5

LOGIN_RATE_LIMIT_WINDOW_MS=60000
LOGIN_RATE_LIMIT_MAX_REQUESTS=5

# Cloudinary (Phase 7 — Website Media V1 provider)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=custom-website-builder
MEDIA_MAX_UPLOAD_BYTES=5000000
